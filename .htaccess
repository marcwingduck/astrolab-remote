# index.html: always ask the server whether there's a newer one (cheap: 304 if not)
# css/js carry their content hash in the name (see deploy.sh), so they never change: cache for good
<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "\.[0-9a-f]{8}\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
